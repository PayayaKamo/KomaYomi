# Copy to `.env` next to docker-compose.yml and edit. Never commit `.env`.

# ---- UI ----
# Default interface language hint: en | zh | ja
MANGA_LOCALE=en
# debug | info | warn | error
LOG_LEVEL=info

# ---- Ports ----
# The container always listens on 3921; change the host-side mapping in compose if needed.
PORT=3921
# Listen address for the standalone server (`npm start`). Defaults to 127.0.0.1.
# SECURITY: the API has no login. Setting HOST=0.0.0.0 lets anyone who can reach the
# port read and modify the library; only do this on a trusted network, ideally behind
# a reverse proxy with authentication. Docker keeps the host-side port on 127.0.0.1
# (see docker-compose.yml) even though the process inside the container listens on
# 0.0.0.0.
HOST=127.0.0.1

# ---- Local dev only ----
# Accept API requests whose Host header is not loopback (for example `npm run dev -- --host`).
# Same warning as above applies; leave unset for normal use.
# KOMAYOMI_ALLOW_LAN=1

# ---- Folders (inside the container; compose maps them to ./raw ./data ./exports) ----
RAW_DIR=/data/raw
DATA_DIR=/data/annotations
EXPORT_DIR=/data/exports

# ---- Remote storage (optional, WebDAV / NAS) ----
# Credentials are read at runtime only; they are never written into the image.
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=
