# Dependencies and build output
node_modules/
dist/
dist-server/
release/
*.tsbuildinfo
*.log

# One package manager only: npm with the tracked package-lock.json.
# Stray pnpm files would also break `npm run format:check`, so never keep them around.
pnpm-lock.yaml
pnpm-workspace.yaml

# Runtime data directory: caches, page docs, history, settings and other generated state.
# Tracked templates stay available to every checkout; everything else is local-only.
data/*
!data/templates/
!data/templates/**
# Generated deliverables
exports/
.screenshots/
.trae-html-share-packages/

# Raw manga pages are copyrighted: never commit them.
# Place your own material under raw/<volume>/<language>/<chapter>/
raw/*
!raw/.gitkeep

# Local-only scratch data
.tmp/

# Build / test intermediates that are safe to regenerate
vite.config.ts.timestamp-*.mjs
tests/.coverage/
coverage/

# Schema-migration backups (pre-upgrade bytes, kept next to the migrated file)
*.v[0-9].bak
*.v[0-9][0-9].bak

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local environment overrides
.env
.env.*
!.env.example

# Local secrets, encryption keys and packaged projects
.secret.key
*.key
data/secrets.json
data/secrets.json.enc
*.mnproj
