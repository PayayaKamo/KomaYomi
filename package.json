{
  "name": "koma-yomi",
  "productName": "KomaYomi",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "KomaYomi（格读）— local-first, panel-by-panel manga intensive reading. Compare Japanese, Chinese and English editions side by side, pin notes to the artwork, and export clean study pages.",
  "author": "PayayaKamo",
  "license": "MIT",
  "keywords": [
    "koma-yomi",
    "komayomi",
    "格读",
    "manga",
    "manga-reader",
    "intensive-reading",
    "parallel-text",
    "multilingual",
    "panel",
    "panel-detection",
    "language-learning",
    "japanese",
    "chinese",
    "english",
    "manga-translation",
    "annotation",
    "notes",
    "markdown-notes",
    "local-first",
    "offline",
    "react",
    "vite",
    "electron"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node dist-server/standalone.mjs",
    "server:build": "node scripts/build-server.mjs",
    "desktop": "npm run build && npm run server:build && electron .",
    "dist:win": "npm run build && npm run server:build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && npm run server:build && electron-builder --dir --publish never",
    "docker:build": "docker build -t koma-yomi:local .",
    "docker:up": "docker compose up --build",
    "i18n:scan": "node scripts/scan-hardcoded-zh.mjs",
    "i18n:scan:strict": "node scripts/scan-hardcoded-zh.mjs --strict",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "docs:preview": "npm --prefix docs run docs:preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,cjs,mjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "docx": "^9.15.4",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webp-wasm": "^1.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
