{
  "name": "manga-memo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "漫画多语言对照阅读与批注 · 本地 Web 应用",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server:build": "node scripts/build-server.mjs",
    "desktop": "npm run build && npm run server:build && electron .",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
